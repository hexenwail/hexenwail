# EmbedSpirv.cmake -- turn the Vulkan SPIR-V CompileSpirv.cmake wrote into a
# C file the client links, so -gpu needs no shader files on disk (#340
# decision 6).  Run in script mode, only under USE_SDL_GPU:
#
#   cmake -DSPV_DIR=<dir> -DREFL=<gl_progid_refl.h> -DOUT_FILE=<spirv_gen.c> \
#         -P EmbedSpirv.cmake
#
# Only <blob>.vk.spv is embedded: that is the one rg_shader.c hands SDL_GPU.
# The .gl.spv twins exist for CompileSpirv's -G check and nothing loads them.
#
# The set embedded is exactly gl_progid_refl.h's rows, and every row must
# have its .vk.spv and every .vk.spv its row, or this fails.  rg_shader.c
# creates each stage with that row's resource counts, so a blob without a row
# could never be created and a row without a blob would be a program -gpu
# cannot build; both mean the checked-in header is stale for these shaders.
#
# Each blob becomes a uint32_t array, not bytes: SPIR-V is a stream of 32-bit
# words, rg_shader.c reflects it as Uint32, and a byte array has no alignment
# guarantee.  Words are rebuilt from the file in whichever byte order its
# magic number says it was written in, so the array holds native words on any
# target.
#
# Deterministic: names sorted, no timestamps, no paths in the output.

if(NOT SPV_DIR OR NOT REFL OR NOT OUT_FILE)
    message(FATAL_ERROR "EmbedSpirv: SPV_DIR, REFL and OUT_FILE are required")
endif()

file(READ "${REFL}" refl_text)
string(REGEX MATCHALL "\n[\t ]*{ \"[a-z0-9_]+\\.(vert|frag|comp)\", RPROG_REFL_" refl_rows "${refl_text}")
set(names "")
foreach(row IN LISTS refl_rows)
    string(REGEX REPLACE ".*\"([a-z0-9_]+\\.(vert|frag|comp))\".*" "\\1" name "${row}")
    list(APPEND names "${name}")
endforeach()
list(LENGTH names nrows)
if(nrows EQUAL 0)
    message(FATAL_ERROR "EmbedSpirv: no blob rows in ${REFL}")
endif()
list(REMOVE_DUPLICATES names)
list(LENGTH names nunique)
if(NOT nunique EQUAL nrows)
    message(FATAL_ERROR "EmbedSpirv: ${REFL} names a blob twice")
endif()
list(SORT names)

file(GLOB present RELATIVE "${SPV_DIR}" "${SPV_DIR}/*.vk.spv")
set(have "")
foreach(f IN LISTS present)
    string(REGEX REPLACE "\\.vk\\.spv$" "" f "${f}")
    list(APPEND have "${f}")
endforeach()

set(missing "")
foreach(name IN LISTS names)
    if(NOT name IN_LIST have)
        list(APPEND missing "${name}")
    endif()
endforeach()
set(unlisted "")
foreach(name IN LISTS have)
    if(NOT name IN_LIST names)
        list(APPEND unlisted "${name}")
    endif()
endforeach()
if(missing OR unlisted)
    string(REPLACE ";" " " missing "${missing}")
    string(REPLACE ";" " " unlisted "${unlisted}")
    message(FATAL_ERROR
        "EmbedSpirv: the .vk.spv in ${SPV_DIR} are not engine/h2shared/gl_progid_refl.h's rows.\n"
        "  rows with no blob: ${missing}\n"
        "  blobs with no row: ${unlisted}\n"
        "A stage or variant was added or removed: regenerate the table with\n"
        "  python3 tools/gen_program_reflection.py ${SPV_DIR}")
endif()

set(out "/* Generated by engine/cmake/EmbedSpirv.cmake -- do not edit.\n")
string(APPEND out " * The Vulkan SPIR-V of every row in gl_progid_refl.h, for rg_shader.c.\n")
string(APPEND out " * Source of truth is engine/shaders. */\n\n")
string(APPEND out "#include \"rg_spirv.h\"\n\n")

set(table "")
set(total 0)
foreach(name IN LISTS names)
    set(spv "${SPV_DIR}/${name}.vk.spv")
    file(SIZE "${spv}" size)
    math(EXPR rem "${size} % 4")
    if(size LESS 20 OR NOT rem EQUAL 0)
        message(FATAL_ERROR "EmbedSpirv: ${name}.vk.spv is ${size} bytes, not a SPIR-V module")
    endif()
    file(READ "${spv}" hex HEX)
    string(SUBSTRING "${hex}" 0 8 magic)
    if(magic STREQUAL "03022307")
        set(word_order "\\4\\3\\2\\1")
    elseif(magic STREQUAL "07230203")
        set(word_order "\\1\\2\\3\\4")
    else()
        message(FATAL_ERROR "EmbedSpirv: ${name}.vk.spv has no SPIR-V magic number (${magic})")
    endif()
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x${word_order}, " words "${hex}")
    # Eight words a line (CMake's regex has no {n}).
    set(w8 "0x........, 0x........, 0x........, 0x........, ")
    string(REGEX REPLACE "(${w8}${w8})" "\\1\n\t" words "${words}")
    string(REPLACE " \n" "\n" words "${words}")
    string(REGEX REPLACE "[ \t\n]+$" "" words "${words}")
    string(MAKE_C_IDENTIFIER "spv_${name}" sym)
    string(APPEND out "static const uint32_t ${sym}[] = {\n\t${words}\n};\n\n")
    string(APPEND table "\t{ \"${name}\", ${sym}, sizeof(${sym}) },\n")
    math(EXPR total "${total} + ${size}")
endforeach()

string(APPEND out "const rg_spirv_t rg_spirv[] = {\n${table}};\n")
string(APPEND out "const int rg_spirv_count = (int)(sizeof(rg_spirv) / sizeof(rg_spirv[0]));\n")

file(WRITE "${OUT_FILE}" "${out}")
message(STATUS "EmbedSpirv: ${nrows} blobs, ${total} bytes of SPIR-V")
