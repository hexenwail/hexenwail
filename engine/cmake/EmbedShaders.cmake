# EmbedShaders.cmake -- turn engine/shaders/*.glsl into a C header of string
# literals, resolving #include "..." along the way, and drop a copy of each
# expanded source (plus an OIT twin of each stage that has an OIT arm, and one
# copy per engine/shaders/variants.txt variant) where CompileSpirv.cmake can
# reach it.  engine/shaders/glonly/*.glsl is embedded too, as macros, and kept
# away from CompileSpirv (see below).
#
# Run in script mode:
#   cmake -DSHADER_DIR=<dir> -DOUT_FILE=<header> [-DVK_DIR=<dir>] \
#         -P EmbedShaders.cmake
#
# The shaders are embedded, never loaded from disk at runtime.  The engine has
# no shader search path, so a missing or truncated file would surface as an
# unrecoverable black screen rather than as an error anyone could act on.
#
# Written in plain CMake rather than as a host tool on purpose: this has to run
# identically under the native, mingw-w64 and emscripten toolchains, and CMake
# is the one program all three are guaranteed to have.  A C bintoc would have to
# be cross-built for the host, which is exactly the kind of thing that works on
# one of those three and not the others.
#
# GLSL has no #include of its own (ARB_shading_language_include is not core and
# is not in GLSL ES at all), so the expansion happens here and the generated
# header holds the fully expanded text.  That also means glslangValidator and
# the GL driver see the same bytes.
#
# A source is named <base>_<stage>.glsl, stage being vert, frag or comp.  The
# C symbol keeps the full name (hiz_copy_comp); the offline copy is renamed to
# <base>.<stage> so glslang can infer the stage from the extension.

if(NOT SHADER_DIR OR NOT OUT_FILE)
    message(FATAL_ERROR "EmbedShaders: SHADER_DIR and OUT_FILE are required")
endif()

# The offline copies carry a #version because glslang needs one; the embedded
# copies do not, because the GL side supplies its own chunk per tier.
set(VK_VERSION_LINE "#version 450 core\n")

file(GLOB SHADER_FILES "${SHADER_DIR}/*.glsl")
list(SORT SHADER_FILES)

set(GENERATED "/* Generated by engine/cmake/EmbedShaders.cmake -- do not edit.\n")
# No "/*" in this comment: every includer would get a -Wcomment warning, and
# since #450 that includes the WEBSOFT build's web_canvas_gl2.c.
string(APPEND GENERATED " * Source of truth is the .glsl files in engine/shaders and\n")
string(APPEND GENERATED " * engine/shaders/glonly. */\n\n")
string(APPEND GENERATED "#ifndef SHADERS_GEN_H\n#define SHADERS_GEN_H\n\n")
# One header for every renderer source, so most of what it declares is unused
# in any given translation unit.  -Wall makes that a warning per shader per
# includer (-Wunused-const-variable is on for C), which would drown the build
# log once the rest of the shaders follow.
string(APPEND GENERATED "#if defined(__GNUC__) || defined(__clang__)\n")
string(APPEND GENERATED "#define SHADER_UNUSED\t__attribute__((unused))\n")
string(APPEND GENERATED "#else\n#define SHADER_UNUSED\n#endif\n\n")

# engine/shaders/glonly/*.glsl: text only the GL side compiles, so it is never
# written to VK_DIR and never reaches the SPIR-V or cross-compile gates.  These
# files are the per-tier #version/precision preambles that GL passes as the
# first glShaderSource chunk, and the WebGL2-only canvas blit for the software
# renderer (WEBSOFT).  Each becomes a string-literal MACRO named after the file
# in upper case (tier_core.glsl -> TIER_CORE), not an array, because the C
# pastes the preambles next to other literals ("... NOPERSP 1\n") and into
# printf formats.  Embedded verbatim, no #include expansion: every byte in the
# file reaches the driver, so they hold no comments of their own (#450).
file(GLOB GLONLY_FILES "${SHADER_DIR}/glonly/*.glsl")
list(SORT GLONLY_FILES)
foreach(glonly ${GLONLY_FILES})
    get_filename_component(name "${glonly}" NAME_WE)
    string(TOUPPER "${name}" macro)
    file(READ "${glonly}" body)
    # A CRLF checkout would put a raw CR into every literal; the C literals
    # these replaced spelled \n and could not pick one up.
    string(REPLACE "\r" "" body "${body}")
    if(body MATCHES "#include")
        message(FATAL_ERROR "EmbedShaders: glonly/${name}.glsl is embedded verbatim and cannot #include")
    endif()
    if(name MATCHES "^tier_" AND body MATCHES "%")
        # The tier preambles are pasted into printf formats (gl_lightcluster.c,
        # gl_postprocess.c), where a % would be read as a conversion.
        message(FATAL_ERROR "EmbedShaders: glonly/${name}.glsl contains a %")
    endif()
    string(REPLACE "\\" "\\\\" body "${body}")
    string(REPLACE "\"" "\\\"" body "${body}")
    string(REPLACE "\n" "\\n\" \\\n\t\"" body "${body}")
    string(APPEND GENERATED "#define ${macro} \\\n\t\"${body}\"\n\n")
endforeach()

if(VK_DIR)
    file(MAKE_DIRECTORY "${VK_DIR}")
endif()

# engine/shaders/variants.txt: the header #defines the engine prepends at
# program-build time (see that file).  Each `variant` line becomes one more
# offline copy of its stage, so SDL_GPU, which cannot compile GLSL at run
# time, has a blob per program GL builds.  `const` lines are for
# tools/test_shader_variants.py and produce nothing here.  Parsed on every
# run, VK_DIR or not, so a malformed manifest fails every toolchain alike.
set(VARIANTS_FILE "${SHADER_DIR}/variants.txt")
if(NOT EXISTS "${VARIANTS_FILE}")
    message(FATAL_ERROR "EmbedShaders: ${VARIANTS_FILE} is missing")
endif()
file(READ "${VARIANTS_FILE}" variants_text)
string(REPLACE "\r" "" variants_text "${variants_text}")
# Comments go first, so they may say anything; line numbers survive because
# the newlines stay.
string(REGEX REPLACE "#[^\n]*" "" variants_text "${variants_text}")
if(variants_text MATCHES ";")
    # CMake would split the line into list items at it.
    message(FATAL_ERROR "EmbedShaders: variants.txt may not contain a ';' outside a comment")
endif()
string(REPLACE "\n" ";" variants_lines "${variants_text}")
set(VARIANT_COUNT 0)
set(lineno 0)
foreach(line IN LISTS variants_lines)
    math(EXPR lineno "${lineno} + 1")
    string(STRIP "${line}" line)
    if(line STREQUAL "")
        continue()
    endif()
    string(FIND "${line}" "\\" backslash)
    if(line MATCHES "[\"']" OR NOT backslash EQUAL -1)
        # separate_arguments would strip them; test_shader_variants.py would not.
        message(FATAL_ERROR "EmbedShaders: variants.txt:${lineno}: no quotes or backslashes")
    endif()
    separate_arguments(words UNIX_COMMAND "${line}")
    list(GET words 0 kind)
    list(LENGTH words nwords)
    if(kind STREQUAL "const")
        if(NOT nwords EQUAL 3)
            message(FATAL_ERROR "EmbedShaders: variants.txt:${lineno}: want `const NAME value`")
        endif()
        continue()
    endif()
    if(NOT kind STREQUAL "variant" OR nwords LESS 4)
        message(FATAL_ERROR
            "EmbedShaders: variants.txt:${lineno}: want `variant <stage> <name> NAME=value ...`")
    endif()
    list(GET words 1 vstage)
    list(GET words 2 vname)
    list(SUBLIST words 3 -1 vdefs)
    if(NOT vstage MATCHES "^[a-z0-9_]+\\.(vert|frag|comp)$")
        message(FATAL_ERROR "EmbedShaders: variants.txt:${lineno}: bad stage `${vstage}`")
    endif()
    string(REGEX REPLACE "\\.(vert|frag|comp)$" "_\\1.glsl" vsrc "${vstage}")
    if(NOT EXISTS "${SHADER_DIR}/${vsrc}")
        message(FATAL_ERROR "EmbedShaders: variants.txt:${lineno}: no stage ${vstage} (${vsrc})")
    endif()
    if(NOT vname MATCHES "^[a-z0-9_]+$")
        message(FATAL_ERROR "EmbedShaders: variants.txt:${lineno}: bad variant name `${vname}`")
    endif()
    set(vtext "")
    set(vnames "")
    foreach(def IN LISTS vdefs)
        if(NOT def MATCHES "^([A-Z_][A-Z0-9_]*)=([^=]+)$")
            message(FATAL_ERROR "EmbedShaders: variants.txt:${lineno}: bad define `${def}`, want NAME=value")
        endif()
        list(FIND vnames "${CMAKE_MATCH_1}" seen)
        if(NOT seen EQUAL -1)
            message(FATAL_ERROR "EmbedShaders: variants.txt:${lineno}: ${CMAKE_MATCH_1} set twice")
        endif()
        list(APPEND vnames "${CMAKE_MATCH_1}")
        string(APPEND vtext "#define ${CMAKE_MATCH_1} ${CMAKE_MATCH_2}\n")
    endforeach()
    set(VARIANT_${VARIANT_COUNT}_STAGE "${vstage}")
    set(VARIANT_${VARIANT_COUNT}_NAME "${vname}")
    set(VARIANT_${VARIANT_COUNT}_TEXT "${vtext}")
    math(EXPR VARIANT_COUNT "${VARIANT_COUNT} + 1")
endforeach()

# Every offline copy this run writes; anything else in VK_DIR is stale.
set(VK_WRITTEN "")
function(write_vk name content)
    # list(FIND), not IN_LIST: a -P script runs with CMP0057 unset, so CMake
    # 3.x rejects IN_LIST here (the wasm CI job's apt cmake is 3.x).
    list(FIND VK_WRITTEN "${name}" seen)
    if(NOT seen EQUAL -1)
        message(FATAL_ERROR "EmbedShaders: two offline copies would both be ${name}")
    endif()
    set(VK_WRITTEN ${VK_WRITTEN} "${name}" PARENT_SCOPE)
    write_if_changed("${VK_DIR}/${name}" "${content}")
endfunction()

# Rewrite only when the bytes actually change, so a no-op regeneration does not
# force everything downstream to rebuild.
function(write_if_changed path content)
    set(previous "")
    if(EXISTS "${path}")
        file(READ "${path}" previous)
    endif()
    if(NOT previous STREQUAL content)
        file(WRITE "${path}" "${content}")
        message(STATUS "EmbedShaders: wrote ${path}")
    endif()
endfunction()

foreach(shader ${SHADER_FILES})
    get_filename_component(name "${shader}" NAME_WE)
    file(READ "${shader}" body)

    # Resolve includes.  Bounded rather than while(TRUE) so a cyclic include
    # fails the build instead of hanging it.  Each pass resolves one distinct
    # include name (every occurrence of it), so the bound is the most distinct
    # includes one stage may pull in, transitively.  It was 9 (RANGE 8); the
    # alias family's planned split of salias_frag needs about that many on its
    # own (#450).  scripts/webgl-engine-shader-smoke.mjs mirrors this bound and
    # tools/test_embed_include_bound.py keeps the two equal.
    foreach(pass RANGE 31)
        if(NOT body MATCHES "#include \"([^\"]+)\"")
            break()
        endif()
        set(incname "${CMAKE_MATCH_1}")
        if(NOT EXISTS "${SHADER_DIR}/${incname}")
            message(FATAL_ERROR "EmbedShaders: ${name} includes missing ${incname}")
        endif()
        file(READ "${SHADER_DIR}/${incname}" inctext)
        string(REPLACE "#include \"${incname}\"\n" "${inctext}" body "${body}")
    endforeach()
    if(body MATCHES "#include \"")
        message(FATAL_ERROR "EmbedShaders: ${name} has unresolved or cyclic includes")
    endif()

    if(VK_DIR)
        if(name MATCHES "^(.+)_(vert|frag|comp)$")
            set(vbase "${CMAKE_MATCH_1}")
            set(vext "${CMAKE_MATCH_2}")
            write_vk("${vbase}.${vext}" "${VK_VERSION_LINE}${body}")
            # A stage with an `#ifdef OIT` arm is also linked as an OIT twin,
            # with "#define OIT 1" after its header (GL_InitOITProgramSplit).
            # That arm is a separate shader as far as the offline gates go,
            # so give it its own copy, or CompileSpirv never sees oit.inc.
            string(FIND "${body}" "#ifdef OIT\n" oit_arm)
            if(NOT oit_arm EQUAL -1)
                write_vk("${vbase}_oit.${vext}" "${VK_VERSION_LINE}#define OIT 1\n${body}")
            endif()
            # variants.txt copies of this stage, defines in manifest order.
            if(VARIANT_COUNT GREATER 0)
                math(EXPR vlast "${VARIANT_COUNT} - 1")
                foreach(v RANGE ${vlast})
                    if(VARIANT_${v}_STAGE STREQUAL "${vbase}.${vext}")
                        write_vk("${vbase}_${VARIANT_${v}_NAME}.${vext}"
                                 "${VK_VERSION_LINE}${VARIANT_${v}_TEXT}${body}")
                    endif()
                endforeach()
            endif()
        else()
            message(FATAL_ERROR
                "EmbedShaders: ${name} does not end in _vert, _frag or _comp")
        endif()
    endif()

    # C string escaping, then one literal per source line so a shader compile
    # log's line numbers still mean something.
    string(REPLACE "\\" "\\\\" body "${body}")
    string(REPLACE "\"" "\\\"" body "${body}")
    string(REPLACE "\n" "\\n\"\n\t\"" body "${body}")

    string(APPEND GENERATED
           "static const char ${name}[] SHADER_UNUSED =\n\t\"${body}\";\n\n")
endforeach()

# A copy no longer produced (a variant dropped from variants.txt, a stage
# renamed) would otherwise stay in a reused build dir and keep being compiled
# as if the engine still built it.  CompileSpirv.cmake prunes the .spv of a
# copy removed here.
if(VK_DIR)
    file(GLOB vk_present "${VK_DIR}/*.vert" "${VK_DIR}/*.frag" "${VK_DIR}/*.comp")
    foreach(stale ${vk_present})
        get_filename_component(stale_name "${stale}" NAME)
        list(FIND VK_WRITTEN "${stale_name}" seen)
        if(seen EQUAL -1)
            file(REMOVE "${stale}")
            message(STATUS "EmbedShaders: removed stale ${stale}")
        endif()
    endforeach()
endif()

string(APPEND GENERATED "#endif /* SHADERS_GEN_H */\n")

write_if_changed("${OUT_FILE}" "${GENERATED}")
