<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.hexenwail.hexenwail</id>
  <name>Hexen II: Hexenwail</name>
  <summary>Modernized Hexen II engine</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <description>
    <p>
      Hexenwail is a modernized Hexen II engine forked from Hammer of Thyrion (uHexen2).
      It features an SDL3 platform layer, GLSL 4.30 shader pipeline, gamepad support,
      render scale with retro dithering effects, and runtime mod switching.
    </p>
    <p>
      Requires original Hexen II game data files (data1/pak0.pak, data1/pak1.pak).
      Place game data in ~/.hexen2/data1/ or alongside the executable.
    </p>
  </description>

  <launchable type="desktop-id">io.github.hexenwail.hexenwail.desktop</launchable>

  <url type="homepage">https://github.com/hexenwail/hexenwail</url>
  <url type="bugtracker">https://github.com/hexenwail/hexenwail/issues</url>
  <url type="vcs-browser">https://github.com/hexenwail/hexenwail</url>

  <developer id="com.github.bobberb">
    <name>bobberb</name>
  </developer>

  <provides>
    <binary>glhexen2</binary>
  </provides>

  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">intense</content_attribute>
    <content_attribute id="violence-bloodshed">moderate</content_attribute>
  </content_rating>

  <releases>
    <!-- Newest first.  release.yml prepends an entry for each tag it builds;
         without one, software centres show whatever version is listed here,
         which is how this file sat at 26.03-alpha for five months. -->
    <release version="0.7.9-beta.r8" date="2026-08-11">
      <url type="details">https://github.com/hexenwail/hexenwail/releases/tag/0.7.9-beta.r8</url>
    </release>
    <!-- The original 26.03-alpha (2026-03-24) entry was dropped rather than
         kept for history.  AppStream compares versions numerically, so the
         old calendar scheme (26.03) sorts above every version the current
         scheme can produce (0.7.x, and 1.x when it comes) — keeping it made
         the file fail validation with releases-not-in-order forever, and
         told software centres the March alpha was the newest build.  This is
         the same legacy-tag-scheme trap release.yml documents for git tags. -->
  </releases>

  <categories>
    <category>Game</category>
    <category>ActionGame</category>
  </categories>
</component>
